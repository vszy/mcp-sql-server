{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeys": {
    "my-database": "<generate-a-random-32-char-hex-key>"
  },
  "ConnectionStrings": {
    "my-database": "Data source=<server-or-ip>;Database=<database>;Uid=<user>;Pwd=<password>;Pooling=true;Min Pool Size=2;Max Pool Size=1000;MultipleActiveResultSets=true;TrustServerCertificate=True;Encrypt=True"
  }
}
